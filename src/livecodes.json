  "activeEditor": "markup",
  "markup": {
    "language": "html",
    "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Solar Battery Charging Calculator</title>\n\n<style>\n* {\n  box-sizing: border-box;\n}\nbody {\n  font-family: Arial, sans-serif;\n  max-width: 550px;\n  margin: 0 auto;\n  padding: 20px;\n  background-color: #f0f8f5;\n}\n.card {\n  background: #ffffff;\n  padding: 25px;\n  border-radius: 12px;\n  box-shadow: 0 3px 10px rgba(0,0,0,0.1);\n}\nh2 {\n  text-align: center;\n  color: #2c6e49;\n  margin-top: 0;\n}\nlabel {\n  display: block;\n  margin: 18px 0 6px;\n  font-weight: 500;\n  color: #333333;\n}\ninput, select {\n  width: 100%;\n  padding: 12px;\n  border: 1px solid #ccc;\n  border-radius: 6px;\n  font-size: 16px;\n}\n.button-group {\n  display: flex;\n  gap: 12px;\n  margin-top: 25px;\n}\nbutton {\n  flex: 1;\n  padding: 14px;\n  border: none;\n  border-radius: 8px;\n  font-size: 18px;\n  font-weight: bold;\n  cursor: pointer;\n}\n.calculate-btn {\n  background-color: #28a745;\n  color: white;\n}\n.calculate-btn:hover {\n  background-color: #218838;\n}\n.reset-btn {\n  background-color: #dc3545;\n  color: white;\n}\n.reset-btn:hover {\n  background-color: #c82333;\n}\n.result {\n  margin-top: 25px;\n  padding: 20px;\n  background-color: #e9f9ee;\n  border-radius: 10px;\n  border-left: 5px solid #28a745;\n  font-size: 16px;\n  line-height: 1.6;\n}\n.note {\n  font-size: 13px;\n  color: #666;\n  margin-top: 5px;\n  font-style: italic;\n}\n</style>\n</head>\n<body>\n\n<div class=\"card\">\n  <h2>Solar Battery Charging Calculator</h2>\n\n  <label>1. Battery Voltage (Volts)</label>\n  <input type=\"number\" id=\"voltage\" value=\"48\" placeholder=\"e.g. 12, 24, or 48\">\n  <div class=\"note\">Found printed on your battery or manual</div>\n\n  <label>2. Battery Size (Amp Hours - Ah)</label>\n  <input type=\"number\" id=\"capacity\" value=\"400\" placeholder=\"e.g. 100, 200, 400\">\n  <div class=\"note\">Tells how much energy your battery can hold</div>\n\n  <label>3. Current Charge Level (%)</label>\n  <input type=\"number\" id=\"soc\" value=\"50\" placeholder=\"e.g. 20 = low, 100 = full\">\n  <div class=\"note\">How full your battery is right now</div>\n\n  <label>4. Total Solar Panel Power (Kilowatts - kW)</label>\n  <input type=\"number\" step=\"0.1\" id=\"solarKw\" value=\"5\" placeholder=\"e.g. 1, 3, 5\">\n  <div class=\"note\">Add up all panel watts then divide by 1000 (example: 5000W = 5kW)</div>\n\n  <label>5. Average Daily Sunlight Hours</label>\n  <input type=\"number\" step=\"0.1\" id=\"psh\" value=\"5\" placeholder=\"e.g. 4, 5, 6\">\n  <div class=\"note\">Hours of strong, usable sunlight per day</div>\n\n  <label>6. Charge Controller Efficiency (%)</label>\n  <input type=\"number\" id=\"mppt\" value=\"98\" placeholder=\"e.g. 90, 95, 98\">\n  <div class=\"note\">Usually 90–98% for modern controllers</div>\n\n  <label>7. Battery Type</label>\n  <select id=\"batteryType\">\n    <option value=\"0.95\">Lithium (most efficient)</option>\n    <option value=\"0.85\">Lead Acid / Gel / AGM</option>\n  </select>\n  <div class=\"note\">Different batteries charge at different speeds</div>\n\n  <div class=\"button-group\">\n    <button class=\"calculate-btn\" onclick=\"calculate()\">See Results</button>\n    <button class=\"reset-btn\" onclick=\"resetForm()\">Reset</button>\n  </div>\n\n  <div class=\"result\" id=\"result\">\n    Fill in the details above and click \"See Results\"\n  </div>\n</div>\n\n<script>\nfunction calculate() {\n  // Get values entered by user\n  let voltage = parseFloat(document.getElementById(\"voltage\").value);\n  let capacityAh = parseFloat(document.getElementById(\"capacity\").value);\n  let currentChargePercent = parseFloat(document.getElementById(\"soc\").value);\n  let solarKw = parseFloat(document.getElementById(\"solarKw\").value);\n  let sunlightHours = parseFloat(document.getElementById(\"psh\").value);\n  let controllerEfficiency = parseFloat(document.getElementById(\"mppt\").value) / 100;\n  let batteryEfficiency = parseFloat(document.getElementById(\"batteryType\").value);\n\n  // Convert kW back to Watts for calculation logic\n  let solarWatts = solarKw * 1000;\n\n  // Do the calculations\n  let totalBatteryEnergy = (voltage * capacityAh) / 1000; // in kWh\n  let energyNeeded = (totalBatteryEnergy * (100 - currentChargePercent)) / 100;\n  let usableSolarKw = (solarWatts * controllerEfficiency) / 1000; // now in kW\n  let dailyEnergyFromSun = solarKw * sunlightHours * controllerEfficiency; // in kWh\n  let chargeTimeInSunlightHours = (energyNeeded) / (usableSolarKw * batteryEfficiency);\n  let chargeTimeInDays = energyNeeded / dailyEnergyFromSun;\n  let chargingAmps = (solarWatts * controllerEfficiency) / voltage;\n\n  // Show results in simple language\n  document.getElementById(\"result\").innerHTML =\n    \"<strong>🔋 Total Energy Your Battery Can Hold:</strong><br>\" +\n    totalBatteryEnergy.toFixed(2) + \" kilowatt-hours (kWh)<br><br>\" +\n\n    \"<strong>⚡ Energy Still Needed To Fill It:</strong><br>\" +\n    energyNeeded.toFixed(2) + \" kWh<br><br>\" +\n\n    \"<strong>☀️ Usable Power From Your Panels:</strong><br>\" +\n    usableSolarKw.toFixed(2) + \" Kilowatts (kW)<br><br>\" +\n\n    \"<strong>🔌 Approximate Charging Current:</strong><br>\" +\n    chargingAmps.toFixed(1) + \" Amps<br><br>\" +\n\n    \"<strong>📈 Energy Produced On A Sunny Day:</strong><br>\" +\n    dailyEnergyFromSun.toFixed(2) + \" kWh per day<br><br>\" +\n\n    \"<strong>⏱️ Time To Fully Charge:</strong><br>\" +\n    chargeTimeInSunlightHours.toFixed(1) + \" hours of strong sunlight<br>\" +\n    \"<em>≈ That equals about \" + chargeTimeInDays.toFixed(1) + \" full day(s) of normal sunlight</em>\";\n}\n\nfunction resetForm() {\n  document.getElementById(\"voltage\").value = \"48\";\n  document.getElementById(\"capacity\").value = \"400\";\n  document.getElementById(\"soc\").value = \"50\";\n  document.getElementById(\"solarKw\").value = \"5\";\n  document.getElementById(\"psh\").value = \"5\";\n  document.getElementById(\"mppt\").value = \"98\";\n  document.getElementById(\"batteryType\").value = \"0.95\";\n  document.getElementById(\"result\").innerHTML = \"Fill in the details above and click \\\"See Results\\\"\";\n}\n</script>\n\n</body>\n</html>\n"
  },
